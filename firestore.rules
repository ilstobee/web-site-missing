rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Администратор (UID аккаунта cernyhila69@gmail.com)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ZqG4e6PRvrgLr14TxTbLiCS2J0x2';
    }

    // Профили: пользователь читает и пишет только свой профиль
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Команды:
    //   read   — одобренные видит каждый, на модерации — только админ
    //   create — любой авторизованный (команда сразу получает статус pending)
    //   update — только админ (меняет статус: pending → approved / rejected)
    match /teams/{teamId} {
      allow read: if resource == null || resource.data.status == 'approved' || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.creatorId == 'fb-' + request.auth.uid);
    }

    // Сферы (категории) — по той же схеме
    match /categories/{categoryId} {
      allow read: if resource == null || resource.data.status == 'approved' || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.creatorId == 'fb-' + request.auth.uid);
    }

    // Чаты: метаданные (участники для поиска личных чатов, время последнего сообщения)
    match /chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin()
        || (request.auth != null
          && resource.data.kind == 'team'
          && resource.data.participants[0] != null
          && exists(/databases/$(database)/documents/teams/$(resource.data.participants[0]))
          && get(/databases/$(database)/documents/teams/$(resource.data.participants[0])).data.creatorId == 'fb-' + request.auth.uid);
    }

    // Сообщения чата: читают все авторизованные, пишет и правит только автор
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.authorId == 'fb-' + request.auth.uid
          && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorId == 'fb-' + request.auth.uid);
    }

    // Заявки: читает сам заявитель и организатор команды,
    // создаёт сам заявитель, статус меняет только организатор
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && (resource.data.userId == 'fb-' + request.auth.uid
            || resource.data.creatorId == 'fb-' + request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == 'fb-' + request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == 'fb-' + request.auth.uid;
      allow delete: if false;
    }

    // Уведомления: пишет любой авторизованный (создание уведомления получателю),
    // читает и отмечает прочитанными только получатель
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && resource.data.userId == 'fb-' + request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == 'fb-' + request.auth.uid;
      allow delete: if false;
    }
  }
}