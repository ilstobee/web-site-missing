rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Модераторы (администраторы). Добавь сюда UID нужных аккаунтов.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'ZqG4e6PRvrgLr14TxTbLiCS2J0x2'
      ];
    }

    // Профили: любой авторизованный может читать профили (нужно для аватаров,
    // имён участников и подсчёта статистики), пишет и удаляет — только свой.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Команды:
    //   read   — видит любой авторизованный (приложение само скрывает неподтверждённые)
    //   create — любой авторизованный (команда сразу получает статус pending)
    //   update — только админ (меняет статус: pending → approved / rejected)
    //   delete — только админ либо создатель
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.creatorId == 'fb-' + request.auth.uid);
    }

    // Сферы (категории) — по той же схеме
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.creatorId == 'fb-' + request.auth.uid);
    }

    // Чаты: метаданные (участники для поиска личных чатов, время последнего сообщения)
    match /chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if resource == null
        || isAdmin()
        || (request.auth != null
          && resource.data.kind == 'team'
          && resource.data.teamId != null
          && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
          && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.creatorId == 'fb-' + request.auth.uid);
    }

    // Сообщения чата: читают все авторизованные, пишет и правит только автор,
    // удаляет автор сообщения либо создатель команды (для чатов команды)
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.authorId == 'fb-' + request.auth.uid
          && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorId == 'fb-' + request.auth.uid)
        || (request.auth != null
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && get(/databases/$(database)/documents/chats/$(chatId)).data.kind == 'team'
          && get(/databases/$(database)/documents/chats/$(chatId)).data.teamId != null
          && exists(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/chats/$(chatId)).data.teamId))
          && get(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/chats/$(chatId)).data.teamId)).data.creatorId == 'fb-' + request.auth.uid);
    }

    // Заявки: любой авторизованный видит ПРИНЯТЫЕ заявки (для счётчика объединений),
    // а свою заявку и заявки на свою команду — полностью (включая на модерации)
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && (resource.data.status == 'accepted'
            || resource.data.userId == 'fb-' + request.auth.uid
            || resource.data.creatorId == 'fb-' + request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == 'fb-' + request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.creatorId == 'fb-' + request.auth.uid
            || resource.data.userId == 'fb-' + request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.creatorId == 'fb-' + request.auth.uid
            || resource.data.userId == 'fb-' + request.auth.uid);
    }

    // Уведомления: пишет любой авторизованный (создание уведомления получателю),
    // читает и отмечает прочитанными только получатель
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && resource.data.userId == 'fb-' + request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == 'fb-' + request.auth.uid;
      allow delete: if false;
    }

    // Публичная статистика сайта (счётчики в реальном времени)
    match /stats/{statId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}