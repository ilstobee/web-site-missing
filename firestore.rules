rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ЗАМЕНИ PASTE_ADMIN_UID_HERE на свой UID
    // (Authentication → Users → UID своего аккаунта)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID_HERE';
    }

    // Профили: пользователь читает и пишет только свой профиль
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Команды:
    //   read   — одобренные видит каждый, на модерации — только админ
    //   create — любой авторизованный (команда сразу получает статус pending)
    //   update — только админ (меняет статус: pending → approved / rejected)
    match /teams/{teamId} {
      allow read: if resource == null || resource.data.status == 'approved' || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Сферы (категории) — по той же схеме
    match /categories/{categoryId} {
      allow read: if resource == null || resource.data.status == 'approved' || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorId == 'fb-' + request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}